# --- Telegram ---
BOT_TOKEN=123456:REPLACE_ME
BOT_USERNAME=YourGreenValleyBot
# Public https URL of this app (Dokploy domain)
WEB_APP_URL=https://your-domain.example
# Optional: Mini App short name from BotFather (/newapp). Enables t.me/Bot/app?startapp=ref_ID links
MINIAPP_SHORTNAME=

# --- Supabase (service role key, server only) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# --- Admin panel (/admin) ---
ADMIN_PASSWORD=CHANGE_TO_LONG_RANDOM
ADMIN_SESSION_SECRET=CHANGE_TO_ANOTHER_LONG_RANDOM
# Telegram numeric IDs that get a "new withdrawal" notification (comma separated)
ADMIN_IDS=123456789

PORT=3000
INIT_DATA_MAX_AGE_SECONDS=86400

# AdsGram "Task" block server callback secret (choose any long random string).
# In AdsGram → your Task block → Reward URL:  https://YOUR-DOMAIN/api/adsgram/reward?userid=[userId]&secret=THIS_SECRET
ADSGRAM_REWARD_SECRET=
